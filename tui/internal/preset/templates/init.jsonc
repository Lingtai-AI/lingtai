// Authored init: tools belong to this Agent, never to an LLM preset.
// Choose this inline LLM route OR {"preset":{"active":...,"default":...,"allowed":[...]}}.
// Credentials stay external; host.env_file is required when using api_key_env.
{
  "agent": {"name": null, "language": "en", "permissions": {},
            "time_awareness": true, "timezone_awareness": true},
  "llm": {"provider": "openai", "model": "gpt-4o"},
  // Omitted / {} enables every shipped selectable builtin. Per-tool kwargs
  // override setup. false explicitly disables an ordinary builtin. Mandatory
  // Core and notification remain available. No external MCP/account activates.
  "tools": {},
  // Optional Core owner configs inside tools (not selectable capabilities):
  // "email": {"pseudo_agent_subscriptions": ["../human"]}
  // "context": {"summarize_notification_threshold": 3000}
  // Use tools.skills.paths for additional skill roots; plugins declares packages.
  // Desired MCPs ONLY. Curated names derive shipped metadata automatically;
  // plugin names derive package metadata; third-party entries supply type +
  // command/args or url, and external env/account references as appropriate.
  "mcp": {},
  "plugins": []
  // Optional: "host": {"venv_path": "...", "env_file": "..."}
  // System policy: settings/system.json and env. Psyche: settings/psyche.json.
  // Durable memory: system/pad.md; do not embed live Pad/Character here.
}
// Preset files: {"name":"main","description":{"summary":"main"},"llm":{...}}.
// Old manifest/preset-capabilities/addons/pad/pad_file/lingtai inputs remain
// readable where previously supported, without read-time rewriting. Preset
// capabilities never choose tools, including legacy presets. Mixed canonical
// and legacy owner sections fail: explicitly convert with effective comparison.
// Canonical mcp plus a nonempty old mcp/servers.json also requires conversion.
